# ── Database (MongoDB, Prisma 6.19 with `prisma db push`) ──
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/rlonfonyuy?retryWrites=true&w=majority"

# ── UploadThing (all assets: images, PDFs, certificates, CV) ──
UPLOADTHING_TOKEN=

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://rlonfonyuy.online

# ── Auth.js v5 ──
AUTH_SECRET=                 # openssl rand -base64 32
AUTH_URL=https://rlonfonyuy.online
AUTH_TRUST_HOST=true

# ── Admin access gate: the login page only exists at /login?sr=<ADMIN_SECRET_KEY> ──
ADMIN_SECRET_KEY=            # long random string, e.g. openssl rand -hex 24
ADMIN_GATE_JWT_SECRET=       # openssl rand -base64 32 (signs the short-lived admin_gate cookie)

# ── Admin owner (used by `pnpm admin:seed`) ──
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=         # output of `pnpm admin:hash "<password>"`

# ── Optional integrations ──
GITHUB_TOKEN=                # optional, raises GitHub API limits for the activity panel
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
RESEND_API_KEY=              # optional, enables email notifications for inbox + newsletter
CONTACT_TO_EMAIL=            # optional, where contact notifications are sent
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=false
